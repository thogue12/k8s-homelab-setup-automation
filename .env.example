#
# Reuse: existing values are never regenerated when a Healthy_Release already
# exists for the consuming component (Requirement 12.6).

# Generated automatically if missing (openssl rand -hex 32):
AUTHENTIK_SECRET_KEY=""

# Generated automatically if missing (openssl rand -hex 32):
# Same value is used for authentik.postgresql.password and postgresql.auth.password.
AUTHENTIK_POSTGRES_PASSWORD=""

# Prompted interactively if missing (Cloudflare dashboard tunnel token, starts with eyJ):
# Stored only in a Kubernetes Secret, never in Helm values or chart files (Requirement 12.5).
CLOUDFLARE_TUNNEL_TOKEN=""
